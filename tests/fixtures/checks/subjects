#!/usr/bin/env bash
# A fixture check that refuses a commit the range adds whose subject holds BAD
# modes: range
export LC_ALL=C
[ -n "$CHECK_BASE" ] || exit 0
bad=0
for c in $(git rev-list "$CHECK_BASE..$CHECK_HEAD"); do
  case "$(git log -1 --format=%s "$c")" in *BAD*) echo "commit $c's subject holds BAD"; bad=1 ;; esac
done
echo "examined the subjects of $CHECK_BASE..$CHECK_HEAD"
exit "$bad"
