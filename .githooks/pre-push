#!/usr/bin/env bash
# Check each pushed ref with the workspace's bin/check --range, judging that
# ref's own commits and tree: an updated ref from the remote's old SHA, a new
# ref from an empty base with CHECK_REF set to it. A deleted ref is skipped.
set -u
export LC_ALL=C
root=$(git rev-parse --show-toplevel) || exit 2
worst=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *)
      printf 'pre-push: %s is deleted, nothing to check\n' "$remote_ref"
      continue
      ;;
  esac
  case "$remote_sha" in
    *[!0]*) base=$remote_sha ;;
    *) base="" ;;
  esac
  CHECK_REF=${remote_ref#refs/heads/} "$root/bin/check" --range "$base" "$local_sha" </dev/null
  st=$?
  [ "$st" -gt "$worst" ] && worst=$st
done
exit "$worst"
