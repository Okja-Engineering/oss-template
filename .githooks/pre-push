#!/usr/bin/env bash
# Judge each pushed ref with bin/check --range, run from the checks committed
# at HEAD, never from the ref being pushed: no code from a pushed ref runs,
# and uncommitted edits to the checks do not count. The checks read the
# pushed ref's commits and tree through the tree reader. An updated ref is
# judged from the remote's old SHA, a new ref from an empty base with
# CHECK_REF set to it (bin/check judges a remote SHA this clone never fetched
# the same way). Each ref is judged by its own range, though refs share a
# commit: its verdict is the one it gets when pushed alone. A ref that changes
# the checks themselves is judged here by today's checks, and in CI by its
# own. A deleted ref and a notes ref are skipped; a ref on anything but a
# commit cannot be judged.
set -u
set -o pipefail
export LC_ALL=C
root=$(git rev-parse --show-toplevel) || exit 2
cd "$root" || exit 2
# Inside .git rather than TMPDIR, which may be mounted noexec.
scratch=$(mktemp -d "$(git rev-parse --absolute-git-dir)/pre-push.XXXXXX") || exit 2
trap 'rm -rf "$scratch"' EXIT

# HEAD's committed bin/ and foundation/bin/, through a private index.
GIT_INDEX_FILE="$scratch/index" git read-tree HEAD &&
  GIT_INDEX_FILE="$scratch/index" git ls-files -z -- bin foundation/bin |
  GIT_INDEX_FILE="$scratch/index" git checkout-index -z --stdin --prefix="$scratch/head/" &&
  [ -x "$scratch/head/bin/check" ] || {
  printf 'pre-push: HEAD has no committed bin/check to judge the push with\n' >&2
  exit 2
}

worst=0
# A last line without its newline (by hand, not from git) is still judged.
while read -r _local_ref local_sha remote_ref remote_sha || [ -n "${local_sha:-}" ]; do
  st=0
  case "$local_sha" in
    *[!0]*) ;;
    *)
      printf 'pre-push: %s is deleted, nothing to check\n' "$remote_ref"
      continue
      ;;
  esac
  case "$remote_ref" in
    refs/notes/*)
      printf 'pre-push: %s is a notes ref, which bin/check does not judge\n' "$remote_ref"
      continue
      ;;
  esac
  case "$remote_sha" in
    *[!0]*) base=$remote_sha ;;
    *) base="" ;;
  esac
  if ! commit=$(git rev-parse -q --verify "$local_sha^{commit}"); then
    printf 'pre-push: %s is not a commit, so bin/check cannot judge it\n' "$remote_ref" >&2
    st=2
  else
    CHECK_REF=${remote_ref#refs/heads/} "$scratch/head/bin/check" --range "$base" "$commit" </dev/null
    st=$?
  fi
  [ "$st" -gt "$worst" ] && worst=$st
done
exit "$worst"
