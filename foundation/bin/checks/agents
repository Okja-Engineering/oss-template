#!/usr/bin/env bash
# CLAUDE.md is exactly @AGENTS.md, and AGENTS.md is at most 80 lines
# modes: tree staged range
set -u
export LC_ALL=C
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=../lib/tree.sh
. "$here/../lib/tree.sh"
# shellcheck source-path=SCRIPTDIR source=../lib/agents.sh
. "$here/../lib/agents.sh"

src=$(tree_source)
agents_judge "$src" 80
st=$?
[ "$st" -le 1 ] || exit 2
printf 'examined CLAUDE.md and AGENTS.md (%s lines) in %s\n' "$AGENTS_LINES" "$src"
exit "$st"
