#!/usr/bin/env bash
# Stage 01's script (AC7): it writes the answers, from the field schema
# shared/answers.tsv, through bin/lib/answers.sh. A refusal writes nothing,
# and removes nothing unless a removal itself is what failed.
#
# usage:
#   bin/ask setup [FIELD=value...]
#   bin/ask questionnaire
#   bin/ask run NAME [FIELD=value...] [--setup-override FIELD=value...]
#               [--redo [--remove PATH]]
#   bin/ask confirm NAME --by WHO
#
# `setup` records the setup fields given in setup/given.env, with those
# given before and not given again, and rewrites setup/answers.env from
# them: each field given, else its default, worked out again (decision 229).
# `questionnaire` writes setup/questionnaire.md from the schema.
#
# `run` writes stages/01-ask/output/NAME/answers.env: the setup fields from
# setup/answers.env, each FIELD=value after --setup-override replacing one
# for this run only and recorded in the run's setup.override.env, never in
# setup/answers.env (decision 103); the run fields given, recorded in the
# run's given.env, else their defaults; NAME; and TARGET, exactly
# TARGET_ROOT with its ~ expanded, then /NAME (decision 227). A --redo keeps
# only what the operator gave, each run answer and override not given
# again, and works every default out again, as setup does: a field given
# replaces its value, and an override is changed by giving it again, the
# setup value making it harmless; a kept field no longer of its scope is
# dropped, with a note (decision 229). An existing run needs
# --redo, and a target present needs --remove naming it: --remove PATH
# discards the run's target, which the shared discard, bin/lib/discard.sh,
# derives itself from the old answers file's TARGET_ROOT and NAME, after the
# operator's yes at stage 01's checkpoint (AC9, decisions 123, 134, 149,
# 203, 227); a present target it would not take is refused, never routed
# to --remove. --redo clears the
# run's 03 and 02 outputs and then its confirmation, so a clear that fails
# leaves the run confirmed and its files in step, and removes the staging
# directories a killed render left under the old TARGET_ROOT (decision 226).
# Everything that can refuse, the files it writes staged beside them
# included, is settled before anything is removed (decision 230).
#
# `confirm` writes the run's confirmed.md: who, when (UTC) and the answers
# file's blob id, once TARGET is still TARGET_ROOT, ~ expanded under this
# HOME, then /NAME.
#
# Every file is written sorted where it is a list of fields, with LF endings,
# through a temporary file beside it, which a failure or a signal removes.
# Exit 0 when done, 1 on a refusal, 2 on a usage error.
set -u
set -o pipefail
export LC_ALL=C
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
ws=$(CDPATH='' cd -- "$here/.." && pwd)
# shellcheck source-path=SCRIPTDIR source=lib/answers.sh
. "$here/lib/answers.sh"
# shellcheck source-path=SCRIPTDIR source=lib/discard.sh
. "$here/lib/discard.sh"
# shellcheck source-path=SCRIPTDIR source=lib/git.sh
. "$here/lib/git.sh"

SCHEMA=$ws/shared/answers.tsv
SETUP=$ws/setup/answers.env
SETUP_GIVEN=$ws/setup/given.env
QUESTIONNAIRE=$ws/setup/questionnaire.md

usage() {
  printf 'bin/ask: %s\n' "$1" >&2
  printf '%s\n' 'usage: bin/ask setup [FIELD=value...]' '       bin/ask questionnaire' \
    '       bin/ask run NAME [FIELD=value...] [--setup-override FIELD=value...] [--redo [--remove PATH]]' \
    '       bin/ask confirm NAME --by WHO' >&2
  exit 2
}
refuse() {
  printf 'bin/ask: %s\n' "$@" >&2
  exit 1
}

# Each lookup whose 1 is "none" reads a higher status as a failure, never as
# that none (decision 228).

# schema_ok: the schema parses, or the command refuses, naming its faults.
schema_ok() {
  local faults
  faults=$(answers_schema_check "$SCHEMA" shared/answers.tsv 2>&1)
  case $? in
    0) ;;
    1) refuse "shared/answers.tsv does not parse:" "$faults" ;;
    *) refuse "cannot read shared/answers.tsv" ${faults:+"$faults"} ;;
  esac
}

# pick TEXT FIELD LABEL: in PICKED, FIELD's value in TEXT, answers lines,
# from the file LABEL names; the command refuses when it holds no FIELD,
# or when it cannot be read.
pick() {
  PICKED=$(answers_get - "$2" <<<"$1")
  case $? in
    0) ;;
    1) refuse "$3 holds no $2" ;;
    *) refuse "cannot read $2 from $3" ;;
  esac
}

# assignments SCOPE ARG...: the FIELD=value arguments as answers lines, in
# PAIRS; each names a field of SCOPE once, with a value that is one line, or
# the command refuses.
assignments() {
  local scope=$1 arg field seen=" " fault in
  shift
  PAIRS=""
  for arg in "$@"; do
    field=${arg%%=*}
    case "$arg" in
      *=*) ;;
      *) refuse "not FIELD=value: $arg" ;;
    esac
    case "$seen" in
      *" $field "*) refuse "$field is given twice" ;;
    esac
    seen="$seen$field "
    in=$(answers_col "$SCHEMA" "$field" scope)
    case $? in
      0) ;;
      1) refuse "$field: an unknown field" ;;
      *) refuse "cannot read the scope of $field in shared/answers.tsv" ;;
    esac
    case "$in" in
      "$scope") ;;
      setup) refuse "$field is a setup field: give it after --setup-override for this run, or set it with bin/ask setup" ;;
      *) refuse "$field is a $in field, not a $scope field" ;;
    esac
    fault=$(answers_check "$SCHEMA" "$field" "${arg#*=}") || refuse "$fault"
    PAIRS="$PAIRS$arg
"
  done
}

# What this run made, all that a failure or a signal removes: the temporary
# files beside the files it writes, each recorded, with signals held off, as
# it is made, until it is renamed into place (decision 230).
tmps=() dests=()
cleanup() {
  local t
  for t in ${tmps[@]+"${tmps[@]}"}; do
    rm -f -- "$t"
  done
}
# The signals are trapped from the first temporary file on.
trap cleanup EXIT

# stage FILE COMMAND [ARG...]: COMMAND's output in a temporary file beside
# FILE, made exclusively where nothing, not even a symbolic link, is in the
# way. COMMAND runs here, in this shell, never at the end of a pipeline
# (decision 228): when it or the write fails, the command refuses.
stage() {
  local file=$1 tmp=$1.tmp.$$ made=0
  shift
  mkdir -p "${file%/*}" || refuse "cannot make the directory of $file"
  ! present "$tmp" || refuse "cannot write beside $file: $tmp is in the way"
  discard_hold
  if (set -C && : >"$tmp") 2>/dev/null; then
    tmps+=("$tmp")
    dests+=("$file")
    made=1
  fi
  discard_traps
  [ "$made" = 1 ] || refuse "cannot write beside $file: $tmp"
  "$@" >"$tmp" || refuse "cannot write $file"
}
# place: each staged file renamed over its FILE, in the order staged, with
# signals held off, so each FILE is either as it was or whole.
place() {
  local i
  discard_hold
  for i in ${tmps[@]+"${!tmps[@]}"}; do
    mv -f -- "${tmps[$i]}" "${dests[$i]}" || refuse "cannot write ${dests[$i]}"
  done
  tmps=() dests=()
  discard_traps
}
# write FILE COMMAND [ARG...]: stage, then place.
write() {
  stage "$@"
  place
}

# sorted TEXT: TEXT's lines, sorted; a failed sort fails.
sorted() { printf '%s' "$1" | sort; }

# present PATH: something, a dangling symbolic link included, is at PATH.
present() { [ -e "$1" ] || [ -L "$1" ]; }

# kept OLD NEW SCOPE LABEL: in KEPT, NEW, the answers lines given now, then
# each line of OLD, those given before and recorded in LABEL, whose field NEW
# does not give again. A line for a field the schema no longer lists in
# SCOPE is dropped, with a note naming it (decision 229).
kept() {
  local old=$1 new=$2 scope=$3 label=$4 line field in
  KEPT=$new
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    field=${line%%=*}
    answers_get - "$field" <<<"$new" >/dev/null
    case $? in
      0) continue ;;
      1) ;;
      *) refuse "cannot read the answers given" ;;
    esac
    in=$(answers_col "$SCHEMA" "$field" scope)
    case $? in
      0 | 1) ;;
      *) refuse "cannot read the scope of $field in shared/answers.tsv" ;;
    esac
    if [ "$in" != "$scope" ]; then
      printf 'bin/ask: %s holds %s, which is no longer a %s field; it is dropped\n' "$label" "$field" "$scope"
      continue
    fi
    KEPT="$KEPT$line
"
  done <<<"$old"
}

# given FILE LABEL: in GIVEN, the answers lines FILE records as given, read
# through answers_given; none when FILE is absent.
given() {
  GIVEN=""
  present "$1" || return 0
  GIVEN=$(answers_given "$1" "$2") || refuse "$GIVEN"
}

cmd_setup() {
  local text fault
  schema_ok
  assignments setup "$@"
  # Setup keeps what the operator gave, recorded in setup/given.env, and
  # works each other field's default out again (decision 229).
  given "$SETUP_GIVEN" setup/given.env
  kept "$GIVEN" "$PAIRS" setup setup/given.env
  text=$(answers_setup "$SCHEMA" "$KEPT") || refuse "setup/answers.env is not written:" "$text"
  [ -z "$KEPT" ] || stage "$SETUP_GIVEN" sorted "$KEPT"
  stage "$SETUP" printf '%s\n' "$text"
  if [ -z "$KEPT" ] && present "$SETUP_GIVEN"; then
    fault=$(discard_remove "$SETUP_GIVEN") || refuse "$fault"
  fi
  place
  printf 'bin/ask: wrote setup/answers.env\n'
}

cmd_questionnaire() {
  [ "$#" -eq 0 ] || usage "questionnaire takes no argument"
  schema_ok
  write "$QUESTIONNAIRE" answers_questionnaire "$SCHEMA"
  printf 'bin/ask: wrote setup/questionnaire.md\n'
}

cmd_run() {
  local name redo=0 remove="" have_remove=0 to=run arg fault field fields value
  local out="" run_pairs override_pairs given_pairs setup_have outd rel render_md recorded="" old_target="" target
  local old_answers="" old_overrides="" old_given="" line
  local answers_text override_text given_text
  local -a run_args=() override_args=()
  [ "$#" -ge 1 ] || usage "run needs NAME"
  name=$1
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --redo) redo=1 to=run ;;
      --remove)
        [ "$#" -ge 2 ] || usage "--remove needs PATH"
        remove=$2 have_remove=1 to=run
        shift
        ;;
      --setup-override) to=override ;;
      -*) usage "unknown option: $1" ;;
      *)
        if [ "$to" = override ]; then
          override_args+=("$1")
        else
          run_args+=("$1")
        fi
        ;;
    esac
    shift
  done
  [ "$have_remove" = 0 ] || [ "$redo" = 1 ] || usage "--remove goes with --redo"

  # Everything is judged before anything is removed or written.
  schema_ok
  fault=$(answers_check "$SCHEMA" NAME "$name") || refuse "$fault"
  answers_col "$SCHEMA" TARGET_ROOT type >/dev/null
  case $? in
    0) ;;
    1) refuse "shared/answers.tsv has no TARGET_ROOT" ;;
    *) refuse "cannot read TARGET_ROOT's row of shared/answers.tsv" ;;
  esac
  [ -f "$SETUP" ] || refuse "setup/answers.env is missing; run bin/ask setup"
  fault=$(answers_validate "$SCHEMA" "$SETUP" setup setup/answers.env)
  case $? in
    0) ;;
    1) refuse "setup/answers.env is not valid; fix it with bin/ask setup:" "$fault" ;;
    *) refuse "cannot judge setup/answers.env:" "$fault" ;;
  esac
  setup_have=$(answers_read "$SETUP" setup/answers.env) || refuse "$setup_have"
  outd=$ws/stages/01-ask/output/$name
  rel=stages/01-ask/output/$name
  render_md=$ws/stages/02-render/output/$name/render.md
  if [ -f "$outd/answers.env" ]; then
    [ "$redo" = 1 ] ||
      refuse "the run $name exists; change its answers with --redo, at stage 01's checkpoint"
    old_answers=$(answers_read "$outd/answers.env" "$rel/answers.env") || refuse "$old_answers"
    pick "$old_answers" TARGET "$rel/answers.env"
    # The old target, as the discard derives it: the old TARGET_ROOT, from
    # this answers file before it is replaced, then /NAME (decision 227).
    pick "$old_answers" TARGET_ROOT "$rel/answers.env"
    old_target=$(answers_target_for "$PICKED" "$name") || refuse "$rel/answers.env: $old_target"
    given "$outd/setup.override.env" "$rel/setup.override.env"
    old_overrides=$GIVEN
    given "$outd/given.env" "$rel/given.env"
    old_given=$GIVEN
  else
    [ "$redo" = 0 ] || refuse "there is no run $name to redo"
  fi
  assignments run ${run_args[@]+"${run_args[@]}"}
  run_pairs=$PAIRS
  case "
$run_pairs" in
    *'
NAME='*) refuse "NAME is the run's name, given as bin/ask run NAME, not as NAME=value" ;;
  esac
  assignments setup ${override_args[@]+"${override_args[@]}"}
  # A redo keeps only what the operator gave, each override and run answer
  # not given again, and works every default out again (decision 229).
  kept "$old_overrides" "$PAIRS" setup "$rel/setup.override.env"
  override_pairs=$KEPT
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    fault=$(answers_check "$SCHEMA" "${line%%=*}" "${line#*=}") ||
      refuse "$rel/setup.override.env: $fault; give it again with --setup-override"
  done <<<"$override_pairs"
  kept "$old_given" "$run_pairs" run "$rel/given.env"
  given_pairs=$KEPT

  # The setup fields, each overridden or from setup/answers.env; then the
  # run fields, each given or its default; then TARGET.
  fields=$(answers_fields "$SCHEMA" setup) || refuse "cannot read the setup fields of shared/answers.tsv"
  while IFS= read -r field; do
    [ -n "$field" ] || continue
    value=$(answers_get - "$field" <<<"$override_pairs")
    case $? in
      0) ;;
      1)
        pick "$setup_have" "$field" setup/answers.env
        value=$PICKED
        ;;
      *) refuse "cannot read the overrides" ;;
    esac
    out="$out$field=$value
"
  done <<<"$fields"
  value=$(answers_derive "$SCHEMA" run "NAME=$name
$given_pairs" "$out") || refuse "the answers are not written:" "$value"
  out="$out$value
"
  pick "$out" TARGET_ROOT "this run's answers.env"
  target=$(answers_target_for "$PICKED" "$name") || refuse "$target"
  out="${out}TARGET=$target
"
  # What the run writes, made before anything is removed.
  if ! answers_text=$(sorted "$out") || ! override_text=$(sorted "$override_pairs") ||
    ! given_text=$(sorted "$given_pairs"); then
    refuse "cannot sort the answers"
  fi

  # The old target, and the one render.md records: present, either is
  # removed only through the discard, which derives the run's target from
  # the old answers file itself, so the route names it only when the
  # discard would take it.
  recorded=$old_target
  if [ -f "$render_md" ]; then
    recorded=$(answers_record "$render_md" target)
    case $? in
      0) ;;
      1) refuse "$render_md names no target" ;;
      *) refuse "cannot read $render_md" ;;
    esac
  fi
  if [ "$have_remove" = 1 ]; then
    fault=$(discard_check "$remove" "$outd/answers.env" "$name" "$render_md") || refuse "$fault"
  else
    for value in "$recorded" "$old_target"; do
      if [ -z "$value" ] || ! present "$value"; then continue; fi
      fault=$(discard_check "$value" "$outd/answers.env" "$name" "$render_md") ||
        refuse "the target $value is present, and a redo may not remove it: $fault; it is left alone"
      refuse "the target $value is present: with the operator's yes to \"remove $value\", run bin/ask run $name --redo --remove \"$value\" and the answers"
    done
  fi
  if present "$target" && { [ "$have_remove" = 0 ] || [ "$target" != "$remove" ]; }; then
    refuse "the target $target is present, and no --remove names it; it is left alone"
  fi

  # The files it writes, staged beside them, the last thing that can refuse
  # before anything is removed.
  [ -z "$override_pairs" ] || stage "$outd/setup.override.env" printf '%s\n' "$override_text"
  [ -z "$given_pairs" ] || stage "$outd/given.env" printf '%s\n' "$given_text"
  stage "$outd/answers.env" printf '%s\n' "$answers_text"

  # Remove, then place.
  if [ "$have_remove" = 1 ]; then
    fault=$(discard_target "$remove" "$outd/answers.env" "$name" "$render_md") || refuse "$fault"
  fi
  if [ "$redo" = 1 ]; then
    # What derives from the confirmation goes first, so a clear that fails
    # leaves the run confirmed and rendered, and the redo is asked for again.
    for value in "$ws/stages/03-verify/output/$name" "$ws/stages/02-render/output/$name" "$outd/confirmed.md"; do
      fault=$(discard_remove "$value") || refuse "$fault"
    done
    # A killed render's staging directories under the old TARGET_ROOT, which
    # a moved TARGET_ROOT would otherwise strand (decision 226).
    fault=$(discard_leftovers "${old_target%/*}" "$name") || refuse "$fault"
  fi
  if [ -z "$override_pairs" ] && present "$outd/setup.override.env"; then
    fault=$(discard_remove "$outd/setup.override.env") || refuse "$fault"
  fi
  if [ -z "$given_pairs" ] && present "$outd/given.env"; then
    fault=$(discard_remove "$outd/given.env") || refuse "$fault"
  fi
  place
  printf 'bin/ask: wrote stages/01-ask/output/%s/answers.env\n' "$name"
}

cmd_confirm() {
  local name who outd fault blob at
  [ "$#" -eq 3 ] && [ "$2" = --by ] || usage "confirm takes NAME --by WHO"
  name=$1 who=$3
  schema_ok
  fault=$(answers_check "$SCHEMA" NAME "$name") || refuse "$fault"
  git_hermetic
  outd=$ws/stages/01-ask/output/$name
  [ -f "$outd/answers.env" ] || refuse "there is no run $name; write it with bin/ask run $name first"
  fault=$(answers_target_check "$outd/answers.env" "$name")
  case $? in
    0) ;;
    1) refuse "stages/01-ask/output/$name/answers.env: $fault; change the answers with bin/ask run $name --redo" ;;
    *) refuse "stages/01-ask/output/$name/answers.env: $fault" ;;
  esac
  # The operator's name meets the rule every value meets.
  fault=$(answers__value --by "$who") || refuse "$fault; --by names the operator on one line"
  # Hashed as render hashes it: in the workspace, under git.sh's environment.
  blob=$(cd "$ws" && answers_blob "$outd/answers.env") || refuse "cannot hash $outd/answers.env"
  at=$(date -u +%Y-%m-%dT%H:%M:%SZ) || refuse "cannot read the time"
  write "$outd/confirmed.md" printf '%s\n' "# Confirmed: $name" '' "by: $who" "at: $at" "answers: $blob"
  printf 'bin/ask: wrote stages/01-ask/output/%s/confirmed.md\n' "$name"
}

[ "$#" -ge 1 ] || usage "a subcommand is required"
sub=$1
shift
case "$sub" in
  setup) cmd_setup "$@" ;;
  questionnaire) cmd_questionnaire "$@" ;;
  run) cmd_run "$@" ;;
  confirm) cmd_confirm "$@" ;;
  *) usage "unknown subcommand: $sub" ;;
esac
