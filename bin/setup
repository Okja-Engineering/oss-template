#!/usr/bin/env bash
# Point git at the workspace's hooks in .githooks/, through the product's
# bin/setup, which finds the repository from where it sits. A second run
# changes nothing.
set -u
set -o pipefail
export LC_ALL=C
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
exec "$here/../foundation/bin/setup" "$@"
