#!/usr/bin/env bash
# Always-on budgets, stage folders and routing, contract shape, Inputs discipline
# modes: tree staged range
#
# AC1: CLAUDE.md is exactly @AGENTS.md; AGENTS.md is at most 80 lines.
# AC2: CONTEXT.md is at most 60 lines and its `## Routing` table names each
#   stages/NN-slug/ in exactly one row, and nothing else; each stage folder
#   is named NN-slug, holds CONTEXT.md and an output/.gitignore of exactly
#   `*` and `!.gitignore`, and nothing else under output/; each contract is
#   at most 80 lines with the sections Inputs, Process, [Checkpoints],
#   [Audit], Outputs, in that order and no others.
# AC3: Inputs is one table, | Source | File/Location | Section/Scope | Why |,
#   and nothing else; each row's File/Location names one file in backticks,
#   relative to its stage folder and climbing only by a leading run of ../,
#   that reaches a tracked regular file not in a later stage, or an earlier
#   stage's ../NN-slug/output/<name>/FILE that stage's Outputs lists; every
#   file in a stage's references/ is one of its Inputs.
# AC2: every tracked path is portable: ASCII letters, digits, ., _, -, /
#   and space, and no two spellings of a path or of its directories that
#   differ only in case.
set -u
set -o pipefail
export LC_ALL=C
here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR source=../../foundation/bin/lib/tree.sh
. "$here/../../foundation/bin/lib/tree.sh"
# shellcheck source-path=SCRIPTDIR source=../../foundation/bin/lib/agents.sh
. "$here/../../foundation/bin/lib/agents.sh"

src=$(tree_source)
listing=$(tree_list "$src") || exit 2
paths=$(printf '%s\n' "$listing" | sed 's/^[^	]*	//') || exit 2
refused=0

refuse() {
  printf '%s\n' "$1"
  refused=1
}
# Each lookup reads a here-string, not a pipe: grep -q stops at its match,
# and under pipefail a writer it leaves mid-list would fail the lookup.
# grep's 1 is "no"; any higher status is a lookup that failed, and the check
# cannot run (decision 228). Each is called in the check's own shell.
# holds LIST LINE: LIST, lines, holds LINE exactly.
holds() {
  grep -Fxq -- "$2" <<<"$1"
  case $? in
    0) return 0 ;;
    1) return 1 ;;
    *) exit 2 ;;
  esac
}
# matches TEXT ERE: TEXT, one line, matches ERE.
matches() {
  grep -Eq -- "$2" <<<"$1"
  case $? in
    0) return 0 ;;
    1) return 1 ;;
    *) exit 2 ;;
  esac
}
has_path() { holds "$paths" "$1"; }
# under DIR: the paths under DIR/, matched literally. Every list a rule reads
# has its status read, and the check cannot run when one fails (decision
# 228).
under() { printf '%s\n' "$paths" | P="$1/" awk 'index($0, ENVIRON["P"]) == 1'; }
has_dir() {
  local held
  held=$(under "$1") || exit 2
  [ -n "$held" ]
}
# mode_of PATH: the mode the listing gives PATH, matched literally, or nothing.
mode_of() {
  printf '%s\n' "$listing" | P="$1" awk '
    { i = index($0, "\t") }
    !found && substr($0, i + 1) == ENVIRON["P"] { print substr($0, 1, index($0, " ") - 1); found = 1 }'
}
lines_of() { tree_cat "$src" "$1" | awk 'END { print NR }'; }

# section FILE NAME: the lines of FILE's `## NAME` section, outside fences.
section() {
  tree_cat "$src" "$1" | awk -v want="## $2" '
    /^```/ { fence = !fence }
    !fence && /^## / { insec = ($0 == want); next }
    insec { print }'
}
# h2s FILE: FILE's level-2 headings, in order, on one line.
h2s() {
  tree_cat "$src" "$1" | awk '
    /^```/ { fence = !fence }
    !fence && /^## / { printf "%s%s", sep, substr($0, 4); sep = " " }'
}
# body_rows: a Markdown table's rows after its header and separator.
body_rows() { awk '/^\|/ { n++; if (n > 2) print }'; }
# input_rows: an Inputs section in; per row of its table `ENTRY<TAB>PATH`,
# PATH the code span its File/Location cell holds, and `BAD<TAB>WHY` for each
# line that breaks the one shape Inputs takes: the table
# `| Source | File/Location | Section/Scope | Why |`, its delimiter row, then
# rows of four cells, File/Location one code span and the other cells plain
# text: no backtick, <, [, ], @, &, carriage return, :// or www. in any
# case, each cell judged on its own.
# Blank lines may come before and after the table; nothing else may.
# shellcheck disable=SC2016 # a literal backtick, the Markdown code span
input_rows() {
  awk '
    BEGIN { H = "| Source | File/Location | Section/Scope | Why |" }
    # cells S: split the row S into c[1..n] as GitHub does, an escaped pipe
    # text and not a border; n, or 0 when S is not a row.
    function cells(s,   n, i) {
      sub(/[ \t]+$/, "", s)
      if (length(s) < 2 || s !~ /^\|.*\|$/) return 0
      gsub(/\\\|/, "\001", s)
      n = split(substr(s, 2, length(s) - 2), c, "|")
      for (i = 1; i <= n; i++) {
        gsub(/^[ \t]+|[ \t]+$/, "", c[i])
        gsub(/\001/, "|", c[i])
      }
      return n
    }
    function bad(why) { print "BAD\t" why ": " $0 }
    # plain X NAME: why the cell NAME, holding X, is not plain text, or nothing.
    function plain(x, name) {
      if (index(x, "`")) return name " holds a backtick, which GitHub reads as code"
      if (index(x, "<")) return name " holds <, which GitHub may read as HTML"
      if (index(x, "[")) return name " holds [, which GitHub may read as a link"
      if (index(x, "]")) return name " holds ], which GitHub may read as a link"
      if (index(x, "@")) return name " holds @, which GitHub may read as an email link"
      if (index(x, "&")) return name " holds &, which GitHub may read as a character reference"
      if (index(x, "\r")) return name " holds a carriage return, which GitHub reads as a line break"
      if (index(x, "://")) return name " holds ://, a URL"
      if (index(tolower(x), "www.")) return name " holds www., in any case, which GitHub may read as a link"
      return ""
    }
    /^[ \t]*$/ {
      if (at == "delimiter") print "BAD\tits header without its delimiter row"
      if (at != "") at = "after"
      next
    }
    at == "" && cells($0) == 4 && c[1] == "Source" && c[2] == "File/Location" &&
      c[3] == "Section/Scope" && c[4] == "Why" { at = "delimiter"; next }
    at == "delimiter" {
      at = "rows"
      if (cells($0) != 4 || c[1] !~ /^:?-+:?$/ || c[2] !~ /^:?-+:?$/ ||
        c[3] !~ /^:?-+:?$/ || c[4] !~ /^:?-+:?$/) bad("the line after its header is not its delimiter row")
      next
    }
    at == "rows" {
      if (cells($0) != 4) bad("a row without four cells")
      else if (c[2] !~ /^`[^` ]([^`]*[^` ])?`$/) bad("a File/Location cell that is not one path in backticks")
      else if ((why = plain(c[1], "Source")) != "" || (why = plain(c[3], "Section/Scope")) != "" ||
        (why = plain(c[4], "Why")) != "") bad(why)
      else print "ENTRY\t" substr(c[2], 2, length(c[2]) - 2)
      next
    }
    { bad("a line outside its " H " table") }
    END {
      if (at == "") print "BAD\tno " H " table"
      if (at == "delimiter") print "BAD\tits header without its delimiter row"
    }'
}
# normalize PATH: resolve . and .. segments; empty when it leaves the root.
normalize() {
  printf '%s\n' "$1" | awk -F/ '{
    n = 0
    for (i = 1; i <= NF; i++) {
      if ($i == "" || $i == ".") continue
      if ($i == "..") { if (n == 0) { print ""; exit } n--; continue }
      s[++n] = $i
    }
    out = ""
    for (i = 1; i <= n; i++) out = out (i > 1 ? "/" : "") s[i]
    print out
  }'
}
stage_num() { case "$1" in [0-9][0-9]-*) printf '%s' "${1%%-*}" ;; *) printf '' ;; esac; }
# outputs_of STAGE: the backticked names in STAGE's ## Outputs, one a line;
# none for a stage with no contract. Exit nonzero when it cannot be read.
outputs_of() {
  has_path "stages/$1/CONTEXT.md" || return 0
  section "stages/$1/CONTEXT.md" Outputs | awk '{
    s = $0
    while (match(s, /`[^`]*`/)) {
      print substr(s, RSTART + 1, RLENGTH - 2)
      s = substr(s, RSTART + RLENGTH)
    }
  }'
}

# --- AC1, the product's rule -------------------------------------------------
agents_judge "$src" 80
case $? in
  0) ;;
  1) refused=1 ;;
  *) exit 2 ;;
esac

# --- AC2: the tree is portable -------------------------------------------------
# Every rule below judges a path by its literal spelling, which is sound only
# where the disk opens no other path for it; a disk that folds case or
# Unicode would. So each path holds only ASCII letters, digits, ., _, -, /
# and space, and no two spellings of a path, or of any of its directories,
# differ only in case. Two spellings first differ in one segment under one
# parent, so each set of twins is named once, under that parent.
unportable=$(printf '%s\n' "$paths" | awk '!/^[A-Za-z0-9._ \/-]*$/') || exit 2
while IFS= read -r p; do
  [ -n "$p" ] || continue
  refuse "$p: not a portable path: only ASCII letters, digits, ., _, -, / and space"
done <<<"$unportable"
twins=$(printf '%s\n' "$paths" | awk -F/ '
  NF {
    parent = ""
    for (i = 1; i <= NF; i++) {
      shown = parent $i (i < NF ? "/" : "")
      k = parent tolower($i)
      if (!(shown in seen)) {
        seen[shown] = 1
        n[k]++
        list[k] = list[k] (n[k] > 1 ? " and " : "") shown
      }
      parent = parent $i "/"
    }
  }
  END { for (k in n) if (n[k] > 1) print list[k] }' | sort) || exit 2
while IFS= read -r t; do
  [ -n "$t" ] || continue
  refuse "$t: tracked paths that differ only in case"
done <<<"$twins"

# --- AC2: stage folders ------------------------------------------------------
stages=$(printf '%s\n' "$paths" | awk -F/ '$1 == "stages" && NF >= 3 { print $2 }' | sort -u) || exit 2
# Every list of names or paths is read a line at a time, never split on
# spaces or expanded as a glob; the tree reader refuses a newline in a path.
while IFS= read -r s <&3; do
  [ -n "$s" ] || continue
  matches "$s" '^[0-9][0-9]-[a-z]+(-[a-z]+)*$' ||
    refuse "stages/$s/: the name is not NN-slug (NN-[a-z]+(-[a-z]+)*)"
  has_path "stages/$s/CONTEXT.md" || refuse "stages/$s/: no CONTEXT.md"
  if has_path "stages/$s/output/.gitignore"; then
    # Every byte counts: a trailing blank line is not the two lines.
    ignore=$(tree_cat "$src" "stages/$s/output/.gitignore" && printf x) || exit 2
    ignore=${ignore%x}
    [ "$ignore" = '*
!.gitignore' ] || [ "$ignore" = '*
!.gitignore
' ] || refuse "stages/$s/output/.gitignore: not exactly the lines * and !.gitignore"
  else
    refuse "stages/$s/output/.gitignore: missing"
  fi
  held=$(under "stages/$s/output") || exit 2
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ "$p" = "stages/$s/output/.gitignore" ] || refuse "$p: a tracked file under output/"
  done <<<"$held"
done 3<<EOF
$stages
EOF

# --- AC2: CONTEXT.md and its routing table -----------------------------------
if has_path CONTEXT.md; then
  count=$(lines_of CONTEXT.md) || exit 2
  [ "$count" -le 60 ] || refuse "CONTEXT.md: $count lines, over 60"
  # Read whole, its status read: a CONTEXT.md that cannot be read is a check
  # that cannot run, not one with no routing table.
  routing=$(tree_cat "$src" CONTEXT.md | awk '$0 == "## Routing" { n++ } END { print n + 0 }') || exit 2
  if [ "$routing" -gt 0 ]; then
    # Each row counts a stage once, however often it mentions it.
    routed=$(section CONTEXT.md Routing | body_rows | awk '{
      split("", seen)
      s = $0
      while (match(s, /stages\/[^\/[:space:]`|()]*\//)) {
        name = substr(s, RSTART + 7, RLENGTH - 8)
        if (!(name in seen)) { seen[name] = 1; print name }
        s = substr(s, RSTART + RLENGTH)
      }
    }') || exit 2
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      times=$(printf '%s\n' "$routed" | S=$s awk '$0 == ENVIRON["S"] { n++ } END { print n + 0 }') || exit 2
      [ "$times" -eq 1 ] || refuse "CONTEXT.md: the routing table names stages/$s/ $times times, not once"
    done <<EOF
$stages
EOF
    names=$(printf '%s\n' "$routed" | sort -u) || exit 2
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      holds "$stages" "$s" ||
        refuse "CONTEXT.md: the routing table names stages/$s/, which is not a stage folder"
    done <<<"$names"
  else
    refuse "CONTEXT.md: no ## Routing table"
  fi
else
  refuse "CONTEXT.md: missing"
fi

# --- AC2, AC3: each contract -------------------------------------------------
while IFS= read -r s <&3; do
  [ -n "$s" ] || continue
  contract="stages/$s/CONTEXT.md"
  has_path "$contract" || continue
  num=$(stage_num "$s")
  count=$(lines_of "$contract") || exit 2
  [ "$count" -le 80 ] || refuse "$contract: $count lines, over 80"
  sections=$(h2s "$contract") || exit 2
  case "$sections" in
    "Inputs Process Outputs" | "Inputs Process Checkpoints Outputs" | \
      "Inputs Process Audit Outputs" | "Inputs Process Checkpoints Audit Outputs") ;;
    *) refuse "$contract: sections are not Inputs, Process, [Checkpoints], [Audit], Outputs, in order" ;;
  esac

  inputs=""
  rows=$(section "$contract" Inputs | input_rows) || exit 2
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    path=${row#*	}
    if [ "${row%%	*}" = BAD ]; then
      refuse "$contract: Inputs: $path"
      continue
    fi
    case "$path" in
      /*)
        refuse "$contract: Inputs \`$path\` is absolute, where it is read from its stage folder"
        continue
        ;;
      *'*'* | *'?'* | *'['*)
        refuse "$contract: Inputs \`$path\` is a glob"
        continue
        ;;
      */)
        refuse "$contract: Inputs \`$path\` ends in /, where Inputs name files"
        continue
        ;;
    esac
    # Only a leading run of ../ climbs; any other . or .. would judge the path
    # by a name it may never reach (a file, or a missing directory). A path
    # of .. alone climbs to a directory.
    rest=$path
    while [ "${rest#../}" != "$rest" ]; do rest=${rest#../}; done
    if [ "$rest" = .. ]; then
      refuse "$contract: Inputs \`$path\` is a directory"
      continue
    fi
    case "/$rest/" in
      */./* | */../*)
        refuse "$contract: Inputs \`$path\` has a . or .. outside its leading ../ run"
        continue
        ;;
    esac
    target=$(normalize "stages/$s/$path") || exit 2
    if [ -z "$target" ]; then
      refuse "$contract: Inputs \`$path\` does not resolve"
      continue
    fi
    inputs="$inputs$target
"
    # Opened as written, it must reach a tracked regular file: a link is
    # not followed, since its target may lie anywhere.
    mode=$(mode_of "$target") || exit 2
    if [ "$mode" = 120000 ]; then
      refuse "$contract: Inputs \`$path\` is a symbolic link, not a file"
    elif [ "$mode" = 160000 ]; then
      refuse "$contract: Inputs \`$path\` is a submodule, not a file"
    elif [ -n "$mode" ]; then
      case "$target" in
        stages/*/*)
          other=${target#stages/}
          other=${other%%/*}
          onum=$(stage_num "$other")
          if [ -n "$num" ] && [ -n "$onum" ] && [ "$onum" -gt "$num" ]; then
            refuse "$contract: Inputs \`$path\` is in a later stage"
          fi
          ;;
      esac
    elif has_dir "$target"; then
      refuse "$contract: Inputs \`$path\` is a directory"
    else
      other=${target#stages/}
      other=${other%%/*}
      file=${target##*/}
      if [ "$target" = "stages/$other/output/<name>/$file" ] && holds "$stages" "$other"; then
        onum=$(stage_num "$other")
        if [ -z "$num" ] || [ -z "$onum" ] || [ "$onum" -ge "$num" ]; then
          refuse "$contract: Inputs \`$path\` is an output of the same or a later stage"
        else
          outs=$(outputs_of "$other") || exit 2
          holds "$outs" "$file" || holds "$outs" "output/<name>/$file" ||
            refuse "$contract: Inputs \`$path\` is not in stages/$other/'s Outputs"
        fi
      else
        refuse "$contract: Inputs \`$path\` does not resolve"
      fi
    fi
  done <<EOF
$rows
EOF

  held=$(under "stages/$s/references") || exit 2
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    holds "$inputs" "$p" || refuse "$p: in references/ but not in the stage's Inputs"
  done <<<"$held"
done 3<<EOF
$stages
EOF

printf 'examined CLAUDE.md, AGENTS.md, CONTEXT.md and %s stage folders in %s\n' \
  "$(printf '%s' "$stages" | grep -c .)" "$src"
exit "$refused"
